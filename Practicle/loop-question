// Q18. First digit print karo

let number = 4567;
let firstDigit = 0;
let lastDigit = 0;

for (let i = number; i > 0; i = Math.floor(i / 10)) {
  let digit = number % 10;
  firstDigit = i;
  lastDigit = digit;
}

console.log(`First Digit: ${firstDigit}`);
console.log(`Last Digit: ${lastDigit}`);

// Q16. Product of digits nikalo

let number = 152;
let pSum = 0;

for(let i=number;i>0;i=Math.floor(i/10)){
  let digit = i%10;
  pSum += digit;
}

console.log(`Product of digits: ${pSum}`);

// Q15. Sum of digits nikalo

let number = 12345678911;
let sum = 0;


for(let i=number;i>0;i=Math.floor(i/10)){
  let digit = i%10;
  sum+=digit;
}

console.log(`Sum of digits: ${sum}`);

// Q14. Number reverse karo

let number = 123456; 
let reverse = 0;

for(let i=number;i>0;i=Math.floor(i/10)){
  let digit = i%10;
  reverse = reverse*10 + digit;
}

console.log(`Reverse Number: ${reverse}`);


// Q13. Count digits in a number

let number = 1234567891;
let count = 0;

for(let i=number;i>0;i=Math.floor(i/10)){
  count++;
}

console.log(`Count Digit: ${count}`);

