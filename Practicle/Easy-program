// 14. Check Profit or Loss

let costPrice = prompt("Enter the cost price: ");
let sellingPrice = prompt("Enter the selling price: ");


if(sellingPrice > costPrice){
  profit = sellingPrice - costPrice;
  console.log("Profit : "+profit);
}

else if(costPrice > sellingPrice){
  lossPrice = costPrice -sellingPrice;
  console.log("Loss: "+lossPrice);
}

else{
  console.log("No Profit And No Loss");
  
}
